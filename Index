<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#111827" />
    <title>CoachTennisIA · MVP dividido</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <style>
      body { -webkit-tap-highlight-color: transparent; }
      .safe { padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); }
    </style>
  </head>
  <body class="bg-gray-100">
    <div id="root"></div>

    <!-- App con Babel (sin export default) -->
    <script type="text/babel" data-presets="react">
      const { useState, useEffect, useMemo } = React;

      // ────────────────────────────────────────────────────────────────────────────
      // Catálogos
      // ────────────────────────────────────────────────────────────────────────────
      const SURFACES = ["Arcilla", "Dura", "Césped"];
      const STYLES = ["Agresivo de fondo", "Contragolpeador", "Todo-terreno", "Saque y volea"];
      const HANDS = ["Diestro", "Zurdo"];
      const STRENGTHS = ["Derecha", "Revés", "Saque", "Volea", "Físico", "Topspin"];
      const WEAKNESSES = ["Revés", "Derecha", "Movimiento", "Juego en la red", "Segundo saque", "Altas (topspin)", "Bajas (slice)"];
      const WEATHER = ["Templado", "Calor", "Frío", "Viento", "Humedad"];
      const FEELINGS = ["Confiado", "Neutro", "Tenso", "Cansado", "Dolor leve"];

      // ────────────────────────────────────────────────────────────────────────────
      // UI Helpers
      // ────────────────────────────────────────────────────────────────────────────
      const Tag = ({ children }) => (
        <span className="inline-block rounded-full border px-2 py-0.5 text-xs text-gray-700">{children}</span>
      );

      const Section = ({ title, right, children }) => (
        <div className="rounded-2xl border bg-white p-4 shadow-sm">
          <div className="mb-3 flex items-center justify-between gap-2">
            <h2 className="text-lg font-semibold">{title}</h2>
            {right}
          </div>
          {children}
        </div>
      );

      const MultiCheck = ({ options, values, onChange }) => (
        <div className="flex flex-wrap gap-2">
          {options.map((opt) => {
            const checked = values.includes(opt);
            return (
              <label key={opt} className={`cursor-pointer select-none rounded-xl border px-3 py-2 text-sm active:scale-[0.99] ${checked ? "bg-gray-900 text-white" : "bg-white"}`}>
                <input
                  type="checkbox"
                  className="mr-2 align-middle"
                  checked={checked}
                  onChange={(e) => {
                    if (e.target.checked) onChange([...values, opt]);
                    else onChange(values.filter((v) => v !== opt));
                    if (navigator.vibrate) navigator.vibrate(10);
                  }}
                />
                {opt}
              </label>
            );
          })}
        </div>
      );

      const Select = ({ label, value, setValue, options }) => (
        <label className="flex flex-col gap-1 text-sm">
          <span className="text-gray-600">{label}</span>
          <select
            className="rounded-xl border px-3 py-3"
            value={value}
            onChange={(e) => { setValue(e.target.value); if (navigator.vibrate) navigator.vibrate(10);} }
          >
            {options.map((o) => <option key={o} value={o}>{o}</option>)}
          </select>
        </label>
      );

      // ────────────────────────────────────────────────────────────────────────────
      // Persistencia simple (LocalStorage)
      // ────────────────────────────────────────────────────────────────────────────
      const saveLS = (k, v) => localStorage.setItem(k, JSON.stringify(v));
      const loadLS = (k, fb) => { try { const v = JSON.parse(localStorage.getItem(k)); return v ?? fb; } catch { return fb; } };

      // ────────────────────────────────────────────────────────────────────────────
      // App principal
      // ────────────────────────────────────────────────────────────────────────────
      function App() {
        // Estado del tab
        const [tab, setTab] = useState("prep"); // prep | live | history

        // Mi perfil
        const [myHand, setMyHand] = useState("Diestro");
        const [myStyle, setMyStyle] = useState("Agresivo de fondo");
        const [myStrengths, setMyStrengths] = useState(["Derecha", "Topspin"]);
        const [myWeaknesses, setMyWeaknesses] = useState(["Juego en la red"]);

        // Rival (prepartido)
        const [oppName, setOppName] = useState("");
        const [oppKnown, setOppKnown] = useState("Lo conozco"); // Lo conozco | Desconocido
        const [oppHand, setOppHand] = useState("Zurdo");
        const [oppStyle, setOppStyle] = useState("Contragolpeador");
        const [oppStrengths, setOppStrengths] = useState(["Revés"]);
        const [oppWeak, setOppWeak] = useState(["Revés", "Segundo saque"]);

        // Contexto
        const [surface, setSurface] = useState("Arcilla");
        const [weather, setWeather] = useState("Templado");

        // En partido (observaciones + marcador + sensaciones)
        const [obs, setObs] = useState({ missBH:0, weak2nd:0, hatesNet:0, strugglesHigh:0, slowMove:0 });
        const bump = (k) => setObs((s) => { const v = { ...s, [k]: s[k] + 1 }; if (navigator.vibrate) navigator.vibrate(10); return v; });
        const resetObs = () => setObs({ missBH:0, weak2nd:0, hatesNet:0, strugglesHigh:0, slowMove:0 });

        const [score, setScore] = useState({ set:1, my:0, opp:0, trend:"Parejo" }); // trend: Ganando | Perdiendo | Parejo
        const [feeling, setFeeling] = useState("Neutro");

        // Historial (perfiles y partidos)
        const [rivals, setRivals] = useState([]); // [{name, profile:{...}, updatedAt}]
        const [matches, setMatches] = useState([]); // [{ts, oppName, surface, weather, notes, obs, score, adviceSnapshot}]

        // Cargar desde LS una vez
        useEffect(() => {
          const s = loadLS("ctia-state", null);
          if (s) {
            setTab(s.tab ?? "prep");
            setMyHand(s.myHand ?? "Diestro");
            setMyStyle(s.myStyle ?? "Agresivo de fondo");
            setMyStrengths(s.myStrengths ?? ["Derecha","Topspin"]);
            setMyWeaknesses(s.myWeaknesses ?? ["Juego en la red"]);

            setOppName(s.oppName ?? "");
            setOppKnown(s.oppKnown ?? "Lo conozco");
            setOppHand(s.oppHand ?? "Zurdo");
            setOppStyle(s.oppStyle ?? "Contragolpeador");
            setOppStrengths(s.oppStrengths ?? ["Revés"]);
            setOppWeak(s.oppWeak ?? ["Revés","Segundo saque"]);

            setSurface(s.surface ?? "Arcilla");
            setWeather(s.weather ?? "Templado");

            setObs(s.obs ?? { missBH:0, weak2nd:0, hatesNet:0, strugglesHigh:0, slowMove:0 });
            setScore(s.score ?? { set:1, my:0, opp:0, trend:"Parejo" });
            setFeeling(s.feeling ?? "Neutro");
          }
          setRivals(loadLS("ctia-rivals", []));
          setMatches(loadLS("ctia-matches", []));
        }, []);

        // Guardar en LS en cambios relevantes
        useEffect(() => {
          saveLS("ctia-state", { tab, myHand, myStyle, myStrengths, myWeaknesses, oppName, oppKnown, oppHand, oppStyle, oppStrengths, oppWeak, surface, weather, obs, score, feeling });
        }, [tab, myHand, myStyle, myStrengths, myWeaknesses, oppName, oppKnown, oppHand, oppStyle, oppStrengths, oppWeak, surface, weather, obs, score, feeling]);
        useEffect(() => saveLS("ctia-rivals", rivals), [rivals]);
        useEffect(() => saveLS("ctia-matches", matches), [matches]);

        // Construcción de consejo
        const advice = useMemo(() => buildAdvice({
          myHand, myStyle, myStrengths, myWeaknesses,
          oppHand, oppStyle, oppStrengths, oppWeak,
          surface, weather,
          inMatch: { obs, score, feeling }
        }), [myHand, myStyle, myStrengths, myWeaknesses, oppHand, oppStyle, oppStrengths, oppWeak, surface, weather, obs, score, feeling]);

        // Guardar/cargar perfil de rival
        const saveRivalProfile = () => {
          if (!oppName) return alert("Escribe el nombre del rival para guardar su perfil.");
          const profile = { oppName, oppHand, oppStyle, oppStrengths, oppWeak, surface, updatedAt: new Date().toISOString() };
          const next = rivals.filter(r => r.oppName !== oppName).concat(profile).sort((a,b) => (b.updatedAt||"").localeCompare(a.updatedAt||""));
          setRivals(next);
          alert("Perfil de rival guardado.");
        };
        const loadRivalProfile = (name) => {
          const r = rivals.find(x => x.oppName === name);
          if (!r) return;
          setOppName(r.oppName);
          setOppHand(r.oppHand);
          setOppStyle(r.oppStyle);
          setOppStrengths(r.oppStrengths);
          setOppWeak(r.oppWeak);
          setSurface(r.surface ?? surface);
          setTab("prep");
        };

        // Guardar partido al historial
        const saveMatch = () => {
          const entry = {
            ts: new Date().toISOString(),
            oppName: oppName || "(sin nombre)",
            surface, weather, obs: {...obs}, score: {...score}, feeling,
            adviceSnapshot: advice,
          };
          setMatches([entry, ...matches]);
          alert("Partido guardado en el historial.");
        };

        // Exportar / Importar JSON
        const exportJSON = () => {
          const blob = new Blob([JSON.stringify({ rivals, matches }, null, 2)], { type: 'application/json' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url; a.download = 'coachtennisia_historial.json'; a.click();
          URL.revokeObjectURL(url);
        };
        const importJSON = (file) => {
          const reader = new FileReader();
          reader.onload = () => {
            try {
              const { rivals: rv = [], matches: mt = [] } = JSON.parse(reader.result);
              setRivals(rv); setMatches(mt);
              alert('Datos importados.');
            } catch(e) { alert('Archivo inválido.'); }
          };
          reader.readAsText(file);
        };

        return (
          <div className="mx-auto max-w-5xl space-y-4 p-3 pb-28 safe">
            <header className="sticky top-0 z-10 rounded-2xl bg-gradient-to-r from-gray-900 to-gray-700 p-5 text-white shadow">
              <div className="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <h1 className="text-xl md:text-2xl font-bold">CoachTennisIA · MVP dividido</h1>
                  <p className="mt-1 text-xs md:text-sm opacity-90">Prepartido · En partido · Historial</p>
                </div>
                <div className="flex items-center gap-2 text-xs">
                  <button onClick={saveRivalProfile} className="rounded-lg border border-white/30 bg-white/10 px-3 py-2 hover:bg-white/20">Guardar rival</button>
                  <button onClick={saveMatch} className="rounded-lg border border-white/30 bg-white/10 px-3 py-2 hover:bg-white/20">Guardar partido</button>
                  <button onClick={exportJSON} className="rounded-lg border border-white/30 bg-white/10 px-3 py-2 hover:bg-white/20">Exportar</button>
                  <label className="cursor-pointer rounded-lg border border-white/30 bg-white/10 px-3 py-2 hover:bg-white/20">
                    Importar
                    <input type="file" className="hidden" accept="application/json" onChange={(e)=> e.target.files?.[0] && importJSON(e.target.files[0])} />
                  </label>
                </div>
              </div>
              <nav className="mt-3 grid grid-cols-3 gap-2 text-sm">
                {[
                  { id: 'prep', label: '1) Preparación prepartido' },
                  { id: 'live', label: '2) Estrategia en partido' },
                  { id: 'history', label: '3) Historial' },
                ].map(t => (
                  <button key={t.id} onClick={() => setTab(t.id)} className={`rounded-xl px-3 py-2 ${tab===t.id? 'bg-white text-gray-900' : 'bg-white/10 text-white'} hover:bg-white/20`}>{t.label}</button>
                ))}
              </nav>
            </header>

            {/* PREPARTIDO */}
            {tab === 'prep' && (
              <div className="grid gap-4 md:grid-cols-2">
                <Section title="Tu perfil">
                  <div className="grid gap-3">
                    <Select label="Mano" value={myHand} setValue={setMyHand} options={HANDS} />
                    <Select label="Estilo" value={myStyle} setValue={setMyStyle} options={STYLES} />
                    <div>
                      <div className="mb-1 text-sm text-gray-600">Fortalezas</div>
                      <MultiCheck options={STRENGTHS} values={myStrengths} onChange={setMyStrengths} />
                    </div>
                    <div>
                      <div className="mb-1 text-sm text-gray-600">Debilidades propias</div>
                      <MultiCheck options={WEAKNESSES} values={myWeaknesses} onChange={setMyWeaknesses} />
                    </div>
                  </div>
                </Section>

                <Section title="Rival y contexto" right={<div className="flex items-center gap-2">
                  <select className="rounded-lg border px-2 py-1 text-sm" value={oppKnown} onChange={(e)=>setOppKnown(e.target.value)}>
                    <option>Lo conozco</option>
                    <option>Desconocido</option>
                  </select>
                  {rivals.length>0 && (
                    <select className="rounded-lg border px-2 py-1 text-sm" onChange={(e)=> e.target.value && loadRivalProfile(e.target.value)}>
                      <option value="">Cargar rival…</option>
                      {rivals.map(r => <option key={r.oppName} value={r.oppName}>{r.oppName}</option>)}
                    </select>
                  )}
                </div>}>
                  <div className="grid gap-3">
                    <label className="flex flex-col gap-1 text-sm">
                      <span className="text-gray-600">Nombre del rival (opcional)</span>
                      <input className="rounded-xl border px-3 py-3" placeholder="Ej: Juan Pérez" value={oppName} onChange={(e)=>setOppName(e.target.value)} />
                    </label>
                    <div className="grid gap-3 md:grid-cols-2">
                      <Select label="Mano rival" value={oppHand} setValue={setOppHand} options={HANDS} />
                      <Select label="Estilo rival" value={oppStyle} setValue={setOppStyle} options={STYLES} />
                    </div>
                    <div>
                      <div className="mb-1 text-sm text-gray-600">Fortalezas del rival</div>
                      <MultiCheck options={STRENGTHS} values={oppStrengths} onChange={setOppStrengths} />
                    </div>
                    <div>
                      <div className="mb-1 text-sm text-gray-600">Debilidades del rival</div>
                      <MultiCheck options={WEAKNESSES} values={oppWeak} onChange={setOppWeak} />
                    </div>
                    <div className="grid gap-3 md:grid-cols-2">
                      <Select label="Superficie" value={surface} setValue={setSurface} options={SURFACES} />
                      <Select label="Clima estimado" value={weather} setValue={setWeather} options={WEATHER} />
                    </div>
                    <div className="flex flex-wrap items-center gap-2 text-xs text-gray-600">
                      <Tag>{myHand}</Tag>
                      <Tag>{myStyle}</Tag>
                      {myStrengths.map((s) => (<Tag key={s}>{s}</Tag>))}
                      {myWeaknesses.map((s) => (<Tag key={"mw"+s}>⚠ {s}</Tag>))}
                    </div>
                  </div>
                </Section>

                <Section title="Plan táctico (prepartido)">
                  <div className="grid gap-4 md:grid-cols-2">
                    <div>
                      <h3 className="mb-1 font-semibold">Plan de juego</h3>
                      <ul className="list-disc pl-5 text-sm text-gray-800">{advice.plan.map((p, i) => (<li key={i}>{p}</li>))}</ul>
                    </div>
                    <div>
                      <h3 className="mb-1 font-semibold">Patrones / jugadas</h3>
                      <ul className="list-disc pl-5 text-sm text-gray-800">{advice.patterns.map((p, i) => (<li key={i}>{p}</li>))}</ul>
                    </div>
                    <div>
                      <h3 className="mb-1 font-semibold">Saque / devolución</h3>
                      <ul className="list-disc pl-5 text-sm text-gray-800">{advice.serveReturn.map((p, i) => (<li key={i}>{p}</li>))}</ul>
                    </div>
                    <div>
                      <h3 className="mb-1 font-semibold">Alertas por debilidades propias</h3>
                      <ul className="list-disc pl-5 text-sm text-gray-800">{advice.selfAlerts.map((p, i) => (<li key={i}>{p}</li>))}</ul>
                    </div>
                  </div>
                </Section>
              </div>
            )}

            {/* EN PARTIDO */}
            {tab === 'live' && (
              <div className="grid gap-4 md:grid-cols-2">
                <Section title="Marcador y sensaciones" right={<div className="flex items-center gap-2 text-xs">
                  <button onClick={()=>setScore(s=>({...s, my: Math.max(0, s.my-1)}))} className="rounded-lg border px-2 py-1">-</button>
                  <span>Juegos Yo: {score.my}</span>
                  <button onClick={()=>setScore(s=>({...s, my: s.my+1}))} className="rounded-lg border px-2 py-1">+</button>
                  <span className="mx-1">/</span>
                  <button onClick={()=>setScore(s=>({...s, opp: Math.max(0, s.opp-1)}))} className="rounded-lg border px-2 py-1">-</button>
                  <span>Rival: {score.opp}</span>
                  <button onClick={()=>setScore(s=>({...s, opp: s.opp+1}))} className="rounded-lg border px-2 py-1">+</button>
                </div>}>
                  <div className="grid gap-3 md:grid-cols-3">
                    <Select label="Tendencia" value={score.trend} setValue={(v)=>setScore(s=>({...s, trend:v}))} options={["Ganando","Parejo","Perdiendo"]} />
                    <Select label="Clima actual" value={weather} setValue={setWeather} options={WEATHER} />
                    <Select label="Sensación actual" value={feeling} setValue={setFeeling} options={FEELINGS} />
                  </div>
                </Section>

                <Section title="Observaciones rápidas (en juego)" right={<button onClick={resetObs} className="rounded-lg border px-3 py-2 text-sm">Reiniciar</button>}>
                  <div className="grid gap-2 grid-cols-2 md:grid-cols-3">
                    <button onClick={() => bump("missBH")} className="rounded-xl border px-3 py-3 text-left active:scale-[0.99] bg-white hover:bg-gray-50">Falla revés · <b>{obs.missBH}</b></button>
                    <button onClick={() => bump("weak2nd")} className="rounded-xl border px-3 py-3 text-left active:scale-[0.99] bg-white hover:bg-gray-50">2º saque débil · <b>{obs.weak2nd}</b></button>
                    <button onClick={() => bump("hatesNet")} className="rounded-xl border px-3 py-3 text-left active:scale-[0.99] bg-white hover:bg-gray-50">Evita la red · <b>{obs.hatesNet}</b></button>
                    <button onClick={() => bump("strugglesHigh")} className="rounded-xl border px-3 py-3 text-left active:scale-[0.99] bg-white hover:bg-gray-50">Sufre bolas altas · <b>{obs.strugglesHigh}</b></button>
                    <button onClick={() => bump("slowMove")} className="rounded-xl border px-3 py-3 text-left active:scale-[0.99] bg-white hover:bg-gray-50">Lento de piernas · <b>{obs.slowMove}</b></button>
                  </div>
                </Section>

                <Section title="Ajustes sugeridos (en partido)">
                  <div className="grid gap-4 md:grid-cols-2">
                    <div>
                      <h3 className="mb-1 font-semibold">Ajustes tácticos</h3>
                      <ul className="list-disc pl-5 text-sm text-gray-800">{advice.inMatch.map((p, i) => (<li key={i}>{p}</li>))}</ul>
                    </div>
                    <div>
                      <h3 className="mb-1 font-semibold">Plan B / C (situacional)</h3>
                      <ul className="list-disc pl-5 text-sm text-gray-800">{advice.fallbacks.map((p, i) => (<li key={i}>{p}</li>))}</ul>
                    </div>
                  </div>
                </Section>
              </div>
            )}

            {/* HISTORIAL */}
            {tab === 'history' && (
              <div className="grid gap-4 md:grid-cols-2">
                <Section title="Perfiles de rivales guardados">
                  {rivals.length === 0 && <p className="text-sm text-gray-600">Aún no guardas rivales.</p>}
                  <div className="grid gap-2">
                    {rivals.map(r => (
                      <div key={r.oppName} className="rounded-xl border p-3 text-sm">
                        <div className="flex items-center justify-between">
                          <div className="font-semibold">{r.oppName}</div>
                          <div className="text-xs text-gray-500">{new Date(r.updatedAt).toLocaleString()}</div>
                        </div>
                        <div className="mt-1 flex flex-wrap gap-2 text-xs text-gray-600">
                          <Tag>{r.oppHand}</Tag>
                          <Tag>{r.oppStyle}</Tag>
                          {r.oppStrengths?.map(s=> <Tag key={s}>F: {s}</Tag>)}
                          {r.oppWeak?.map(s=> <Tag key={"w"+s}>D: {s}</Tag>)}
                        </div>
                        <div className="mt-2 flex gap-2">
                          <button onClick={()=>loadRivalProfile(r.oppName)} className="rounded-lg border px-3 py-1 text-xs">Cargar</button>
                          <button onClick={()=>setRivals(rs=>rs.filter(x=>x.oppName!==r.oppName))} className="rounded-lg border px-3 py-1 text-xs">Eliminar</button>
                        </div>
                      </div>
                    ))}
                  </div>
                </Section>
                <Section title="Partidos guardados">
                  {matches.length === 0 && <p className="text-sm text-gray-600">Aún no guardas partidos.</p>}
                  <div className="grid gap-2">
                    {matches.map((m,idx)=> (
                      <details key={idx} className="rounded-xl border p-3 text-sm">
                        <summary className="cursor-pointer select-none">{new Date(m.ts).toLocaleString()} · vs {m.oppName} · {m.surface} · {m.weather}</summary>
                        <div className="mt-2 grid gap-2">
                          <div className="text-xs text-gray-600">Marcador (juegos): Yo {m.score.my} / Rival {m.score.opp} · Tendencia {m.score.trend} · Sensación {m.feeling}</div>
                          <div>
                            <div className="font-semibold">Ajustes que funcionaron</div>
                            <ul className="list-disc pl-5">{m.adviceSnapshot?.inMatch?.map((x,i)=>(<li key={i}>{x}</li>))}</ul>
                          </div>
                        </div>
                      </details>
                    ))}
                  </div>
                </Section>
              </div>
            )}

            <footer className="pb-8 pt-2 text-center text-xs text-gray-500">Demo MVP · No reemplaza a un entrenador. Usa criterio en cancha 🧠🎾</footer>
          </div>
        );
      }

      // ────────────────────────────────────────────────────────────────────────────
      // Motor de consejo
      // ────────────────────────────────────────────────────────────────────────────
      function buildAdvice(ctx) {
        const { myHand, myStyle, myStrengths, myWeaknesses, oppHand, oppStyle, oppStrengths, oppWeak, surface, weather, inMatch } = ctx;
        const plan = []; const patterns = []; const serveReturn = []; const inMatchAdj = []; const fallbacks = []; const selfAlerts = [];

        const isLeftyOpp = oppHand === "Zurdo"; const iAmLefty = myHand === "Zurdo";
        const strongFH = myStrengths.includes("Derecha"); const strongBH = myStrengths.includes("Revés"); const strongTop = myStrengths.includes("Topspin");

        // Contexto de superficie y clima
        if (surface === "Arcilla") { plan.push("Prioriza consistencia, altura y ángulos; castiga con topspin y profundidad."); if (strongTop) patterns.push("Pelota alta cruzada para empujarlo atrás y abrir paralelos."); }
        if (surface === "Dura") { plan.push("Ritmo medio-alto; busca primeros golpes dominantes y cambios de dirección."); }
        if (surface === "Césped") { plan.push("Pelotas bajas y rápidas: slice, tiros rectos y cerrar en la red."); }
        if (weather === "Viento") { plan.push("Reduce margen de error: más al centro, altura controlada y pies activos."); }
        if (weather === "Calor") { plan.push("Administra energía: puntos cortos con decisión, rutinas de respiración."); }
        if (weather === "Frío") { plan.push("Golpes más acelerados para mantener ritmo; entra a la bola."); }
        if (weather === "Humedad") { plan.push("Prepárate a pelotas más pesadas: busca altura y profundidad."); }

        // Debilidades del rival
        if (oppWeak.includes("Revés")) { plan.push("Cargar el revés del rival en diagonales largas."); patterns.push(strongFH?"Derecha cruzada fuerte al revés + paralela cuando abra":"Cruza al revés y cambia al cuerpo para errores forzados."); }
        if (oppWeak.includes("Derecha")) { plan.push("Ataca su derecha cuando esté en carrera o fuera de balance."); patterns.push("Mueve al revés para abrir y cambia a su derecha."); }
        if (oppWeak.includes("Segundo saque")) serveReturn.push("Adelántate en la devolución del segundo y pega profundo al centro o a su revés.");
        if (oppWeak.includes("Juego en la red")) { plan.push("Mantén pelotas bajas; forzar voleas difíciles."); patterns.push("Pase cruzado + globo si se acerca demasiado."); }
        if (oppWeak.includes("Movimiento")) plan.push("Muévelo con cambios de dirección y dejadas ocasionales.");
        if (oppWeak.includes("Altas (topspin)")) plan.push("Usa bolas altas a su lado débil para provocar errores.");
        if (oppWeak.includes("Bajas (slice)")) plan.push("Slice bajo y profundo, especialmente ángulo corto.");

        // Fortalezas del rival → precauciones
        if (oppStrengths.includes("Saque")) serveReturn.push("Ante primer saque fuerte, bloquea profundo al medio para quitar ángulos.");
        if (oppStrengths.includes("Derecha")) plan.push("Evita dejar derechas cómodas al rival: juega más al cuerpo o al revés.");
        if (oppStrengths.includes("Revés")) plan.push("No regales paralelos al revés sólido; construye con altura y al cuerpo.");

        // Estilos enfrentados
        if (myStyle === "Agresivo de fondo" && oppStyle === "Contragolpeador") plan.push("Ataca con paciencia: entra cuando la bola quede corta; evita sobrejugar.");
        if (myStyle === "Contragolpeador" && oppStyle === "Agresivo de fondo") plan.push("Profundidad y cambio de alturas: que pegue en retroceso, roba tiempo.");
        if (myStyle === "Saque y volea") serveReturn.push("Varía direcciones y sube tras primer saque; ocasional tras segundo.");

        // Mano del rival
        if (isLeftyOpp) { plan.push("Tu derecha cruzada va a su revés; tu revés cruzado a su derecha. Ajusta patrones."); if (oppWeak.includes("Revés")) patterns.push("Derecha cruzada fuerte (a su revés de zurdo) + paralela cuando abra."); }
        if (iAmLefty && !isLeftyOpp) patterns.push("Saque slice abierto de zurdo en iguales; derecha a campo abierto.");

        // Fortalezas y debilidades propias
        if (strongFH) plan.push("Construye con tu derecha: inside‑out al revés y define inside‑in cuando abras cancha.");
        if (strongBH) patterns.push("Revés cruzado pesado para dominar diagonal; paralelo cuando lo bloquees.");
        if (myWeaknesses.includes("Segundo saque")) selfAlerts.push("Protege tu segundo: más kick/altura y porcentajes. Evita zonas previsibles.");
        if (myWeaknesses.includes("Juego en la red")) selfAlerts.push("Si subes, hazlo tras pelota realmente ventajosa o con approach al cuerpo.");
        if (myWeaknesses.includes("Movimiento")) selfAlerts.push("Administra posiciones: evita intercambios laterales largos innecesarios.");
        if (myWeaknesses.includes("Revés")) selfAlerts.push("Evita peloteos que expongan tu revés plano: usa altura o slice de contención.");

        // En partido: observaciones, tendencia y sensaciones
        if (inMatch) {
          const { obs, score, feeling } = inMatch;
          if (obs?.missBH >= 3) inMatchAdj.push("Errores de su revés: insiste en esa diagonal y sube cuando quede corta.");
          if (obs?.weak2nd >= 2) inMatchAdj.push("Segundo vulnerable: adelántate más y resta profundo al cuerpo.");
          if (obs?.hatesNet >= 2) inMatchAdj.push("Si sube, usa pase cruzado o globo; no lo invites.");
          if (obs?.strugglesHigh >= 2) inMatchAdj.push("Sufre bolas altas: aumenta topspin a su lado débil.");
          if (obs?.slowMove >= 2) inMatchAdj.push("Llega tarde: mezcla dejadas y cambios de dirección.");

          if (score?.trend === "Perdiendo") fallbacks.push("Ajusta ritmo: más margen (al centro/alto), selecciona mejor las bolas de ataque.");
          if (score?.trend === "Ganando") fallbacks.push("Consolida: juega a porcentajes, evita riesgos innecesarios tras ventaja.");
          if (feeling === "Cansado") fallbacks.push("Acorta puntos con saque variado + 3er golpe agresivo; respira entre puntos.");
          if (feeling === "Tenso") fallbacks.push("Rutina corta: mirar cuerdas/respirar 6‑10s; apunta grande al centro para re‑tomar timing.");
        }

        serveReturn.push("Primer servicio: porcentajes a zonas (T/abierto) según mano del rival.");
        serveReturn.push("Devolución: profundidad al medio para quitar ángulos; cambia cuando quede corta.");

        const uniq = (arr) => Array.from(new Set(arr.filter(Boolean)));
        return {
          plan: uniq(plan),
          patterns: uniq(patterns),
          serveReturn: uniq(serveReturn),
          inMatch: uniq(inMatchAdj.length ? inMatchAdj : ["Observa 2‑3 puntos, detecta patrón y presiona ahí."]),
          fallbacks: uniq(fallbacks.length ? fallbacks : ["Si el plan A no fluye: sube altura y juega más al centro para resetear el ritmo."]),
          selfAlerts: uniq(selfAlerts.length ? selfAlerts : ["Cuida tus rutinas y selección de tiros en momentos clave."]),
        };
      }

      ReactDOM.createRoot(document.getElementById('root')).render(<App />);
    </script>
  </body>
